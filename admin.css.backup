.admin-body{background:#fff8f2;color:#25272c}.admin-top{position:sticky;top:0;z-index:10;background:#fff;border-bottom:1px solid #eee;padding:14px 4%;display:flex;justify-content:space-between;align-items:center}.admin-top strong{font-size:22px;color:#ff5a00}.admin-top span{margin-left:10px;color:#777;font-size:12px}.admin-wrap{width:min(1180px,calc(100% - 28px));margin:28px auto 60px}.admin-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px}.admin-card{background:#fff;border:1px solid #f0d9cb;border-radius:18px;padding:22px;box-shadow:0 10px 30px rgba(255,90,0,.06);margin-bottom:18px}.login-card{max-width:480px;margin:60px auto}.admin-card h1,.admin-card h2{margin:0 0 8px}.admin-card h1{font-size:28px}.admin-card h2{font-size:20px}.admin-card p{color:#73777f;font-size:13px}.admin-head{display:flex;justify-content:space-between;align-items:center;gap:15px;margin-bottom:18px}.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}.form-grid .full-col{grid-column:1/-1}.admin-card label{display:block;font-size:11px;font-weight:800}.admin-card input,.admin-card textarea,.admin-card select{width:100%;box-sizing:border-box;margin-top:6px;border:1px solid #dfe2e7;border-radius:10px;padding:10px 11px;font:inherit;font-size:13px}.admin-card textarea{resize:vertical}.admin-msg{min-height:18px;color:#16834b!important}.hint{font-size:11px!important}.image-admin-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}.image-item{border:1px solid #eee;border-radius:14px;padding:10px}.image-item img{width:100%;height:110px;object-fit:cover;border-radius:10px;background:#fff8f2}.image-item strong{display:block;font-size:12px;margin:8px 0}.image-item input{font-size:11px!important}.product-admin-list{display:grid;gap:10px}.product-row{display:grid;grid-template-columns:90px 1fr 1fr 1fr 110px 120px;gap:8px;align-items:end;border:1px solid #eee;border-radius:14px;padding:10px}.product-row img{width:90px;height:70px;object-fit:cover;border-radius:9px;background:#fff7ef}.product-row label{font-size:9px}.product-row .actions{display:flex;gap:6px}.product-row button{min-height:34px;padding:0 9px;font-size:10px}.product-row input{padding:8px!important;font-size:11px!important}.product-row .file-input{font-size:9px!important}.btn-danger{background:#ffe8e3;color:#c6381b;border:1px solid #ffd0c6}.full{width:100%}@media(max-width:900px){.admin-grid{grid-template-columns:1fr}.product-row{grid-template-columns:80px 1fr 1fr 1fr}.product-row .actions{grid-column:2/-1}.product-row img{width:80px;height:60px}}@media(max-width:600px){.form-grid,.image-admin-grid{grid-template-columns:1fr}.form-grid .full-col{grid-column:auto}.product-row{grid-template-columns:70px 1fr 1fr}.product-row img{width:70px;height:55px}.product-row label:nth-of-type(3),.product-row label:nth-of-type(4){grid-column:2/-1}.product-row .actions{grid-column:1/-1}.admin-card{padding:16px}}
